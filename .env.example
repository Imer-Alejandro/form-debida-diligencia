# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public URL of this app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONEDRIVE_CONFIG_SECRET=replace-with-64-character-hex-secret

# Optional: Microsoft Entra / Azure App registration (needed for SharePoint uploads)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_SECRET=
SHAREPOINT_SITE_URL=

# Outgoing mail via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Alert recipients and scheduled alert configuration
PURCHASING_EMAILS=
CRON_SECRET=
ALERTS_EXPIRY_DAYS=30,15,5
ALERTS_FORM_MIN_AGE_DAYS=3
ALERTS_AUTO_RENEW=true

# Only needed for `npm run setup:db`
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# ADM Cloud ERP integration (optional)
# See PLAN-IMPLEMENTACION.md �7.4
ADM_BASE_URL=https://api.admcloud.net/api
ADM_COMPANY=
ADM_ROLE=
ADM_APPID=
ADM_USERNAME=
ADM_PASSWORD=
ADM_TOKEN=
